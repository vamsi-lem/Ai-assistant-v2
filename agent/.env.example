# ---------------------------------------------------------------------------
# AI Voice Platform v2 - agent environment
#
# Copy this file to `.env` in the same folder and fill it in.
# NEVER commit `.env`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LiveKit - the room the call runs inside
#
# The SAME project the backend points at. If these differ, the backend will
# create a room the agent never sees and the lead will hear silence.
# ---------------------------------------------------------------------------

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ---------------------------------------------------------------------------
# Backend - where the agent reads lead context and writes transcripts
#
# The agent holds no database credentials. It asks the backend for everything.
#
# Locally:        http://localhost:8000/api
# On Render:      https://lg-maya-backend.onrender.com/api
# On Fly:         https://lg-maya-backend.fly.dev/api
#
# AGENT_API_KEY must match backend/.env EXACTLY. A mismatch shows up as a 401
# and the agent leaves the room without speaking.
# ---------------------------------------------------------------------------

BACKEND_BASE_URL=http://localhost:8000/api
AGENT_API_KEY=


# ---------------------------------------------------------------------------
# Sarvam AI - the ears, the brain and the voice
#
# One key covers all three. Get it at dashboard.sarvam.ai -> API Keys.
# Copy it immediately: you cannot see it again after leaving the page.
# New accounts get about 100 rupees of credit, roughly 18 test calls.
# ---------------------------------------------------------------------------

SARVAM_API_KEY=


# --- Speech to text (the ears) ---------------------------------------------
#
# Language: hi-IN, en-IN, te-IN, ta-IN and 19 others, or `auto` to let Sarvam
# detect it. Use `auto` if leads may open in either Hindi or English.
#
# Mode: `codemix` is the one built for Hinglish. It keeps English words as
# English inside a Hindi sentence instead of transliterating them, which is
# how these calls actually sound. Other options: transcribe, translate,
# verbatim, translit.
#
# Stream type: fast | balanced | simulated. `fast` is right for a live call.

SARVAM_STT_LANGUAGE=hi-IN
SARVAM_STT_MODE=codemix
SARVAM_STT_STREAM_TYPE=fast


# --- LLM (the brain) -------------------------------------------------------
#
# The brain is a separate choice from the ears and voice. All four options
# speak the OpenAI wire protocol, so switching is only this variable plus
# the matching key:
#
#   openai   default. Needs OPENAI_API_KEY from platform.openai.com.
#            gpt-4o-mini is fast, cheap, and handles Hindi and English well.
#   gemini   FREE for testing, no card. Needs GEMINI_API_KEY from
#            aistudio.google.com (Get API key). The free tier allows about
#            250,000 tokens a minute and about 30 requests a minute on
#            the flash-lite model, which is a whole call with room to spare.
#            Google retires model names often; if the log says a model "is
#            no longer available", it names the replacement, put that here.
#            Free tier data may be used by Google to improve their models,
#            so use it for testing, not for real leads.
#   groq     needs GROQ_API_KEY from console.groq.com. Fastest of the four,
#            which matters on a phone call. BUT the free tier allows only
#            8,000 tokens a minute. The agent keeps a turn to about 1,200
#            tokens (short prompt, only the last AGENT_HISTORY_ITEMS lines
#            of transcript sent, longer retries on a 429), so a normal call
#            fits. If the log still shows 429s, add billing on Groq (Dev
#            tier, pay as you go) or use openai.
#   sarvam   Sarvam's own model on their v1 chat endpoint, which is open to
#            every paid account (no beta request needed; only their v2
#            endpoint is still whitelisted, and we do not use it). Same
#            SARVAM_API_KEY as the ears and voice, same credit balance.
#            Runs in India, strong Hindi and Telugu. Before trusting it on
#            real calls, compare its per turn latency with gemini in the
#            agent log; a 105B model can be slower than the small US models.
#            One way to check access without starting the agent (paste your
#            key in place of sk_...):
#              Invoke-RestMethod https://api.sarvam.ai/v1/chat/completions -Method Post -ContentType 'application/json' -Headers @{'api-subscription-key'='sk_...'} -Body '{"model":"sarvam-105b-conversations","messages":[{"role":"user","content":"Say hello in Telugu"}]}'
#            A reply with choices[0].message.content means you are in. A 400
#            mentioning beta means write to Sarvam support asking for chat
#            completions access on your account.
#
# Do not put a flagship model here. On a phone call a three second pause feels
# broken, so speed matters more than intelligence, and confirming a name and
# noting a callback time is not a hard task.

LLM_PROVIDER=gemini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# flash-lite: most requests a minute on the free tier, quickest replies.
# The plain flash model is a little smarter but allows fewer requests.
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
# Ask Groq which models YOUR key can use (paste your key in place of gsk_...):
#   (Invoke-RestMethod https://api.groq.com/openai/v1/models -Headers @{Authorization='Bearer gsk_...'}).data.id
# Groq retired all Llama models on 16 Aug 2026. Current production models:
#   openai/gpt-oss-120b   stronger, still fast, better Hindi   (default)
#   openai/gpt-oss-20b    fastest, lighter
GROQ_MODEL=openai/gpt-oss-120b

# Only used when LLM_PROVIDER=sarvam.
#   sarvam-105b-conversations   built for voice agents, 32K context (default)
#   sarvam-105b                 general model, 128K context
SARVAM_LLM_MODEL=sarvam-105b-conversations


# --- Text to speech (the voice) --------------------------------------------
#
# This is about two thirds of your Sarvam bill, which is why the prompt keeps
# replies to one or two sentences.
#
# The speaker must belong to the model version. A speaker from another version
# is rejected when the agent starts the call, and the job crashes before a word
# is spoken. These are the speakers bulbul:v3 accepts:
#
#   shubh, ritu, rahul, pooja, simran, kavya, amit, ratan, rohan, dev, ishita,
#   shreya, manan, sumit, priya, aditya, kabir, neha, varun, roopa, aayan,
#   ashutosh, advait, amelia, sophia, suhani, rupali, tanya, shruti, kavitha
#
# To hear the differences before choosing, use the playground at
# dashboard.sarvam.ai. The voice is the whole first impression of the call, so
# it is worth two minutes.
#
# Pace: 0.5 to 2.0. Leave at 1.0 unless she sounds rushed.
#
# Temperature is the naturalness dial for bulbul:v3. Sarvam's guide: 0.3 to
# 0.5 flat and professional, 0.6 reliable, 0.7 to 0.8 warm and
# conversational, 0.9 and up theatrical. 0.75 for a counsellor's colleague.
#
# Sarvam names priya and ishita as the strongest female voices across
# languages. Try priya, ishita and shreya on the same Telugu sentence and
# choose by ear; it is only this line.

SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.75


# ---------------------------------------------------------------------------
# Languages
#
# Maya greets in AGENT_GREETING_LANGUAGE, asks which language the lead wants
# from AGENT_LANGUAGES, then switches to their answer for the whole call.
# Names must be ones Sarvam speaks: hindi, english, telugu, tamil, kannada,
# malayalam, marathi, bengali, gujarati, punjabi, odia.
# ---------------------------------------------------------------------------

AGENT_LANGUAGES=english,hindi,telugu
AGENT_GREETING_LANGUAGE=en-IN


# ---------------------------------------------------------------------------
# Turn timing and silence
#
# Seconds Maya waits after the lead stops before replying (min), and the
# most she will wait when unsure (max). Lower the min if she feels slow.
# ---------------------------------------------------------------------------

AGENT_MIN_ENDPOINTING_DELAY=0.6
AGENT_MAX_ENDPOINTING_DELAY=3.0

# How the end of the lead's turn is decided.
#   vad    silence alone: after the min delay above of quiet, the turn is
#          over. Fastest. The default.
#   stt    the ears' own end-of-sentence signal plus the delays above.
#   auto   the framework's turn-detector model. It was timing out against
#          LiveKit's cloud on a real call and adding two to four seconds
#          to every reply.
AGENT_TURN_DETECTION=vad

# Interruptions. She stops mid-sentence only when the lead has talked over
# her for this many seconds AND at least this many words were transcribed.
# If she stops and no words follow within the timeout, she resumes where
# she left off. Raise the first two if a TV keeps cutting her off; lower
# them if leads complain she does not stop when asked.
AGENT_MIN_INTERRUPTION_DURATION=1.2
AGENT_MIN_INTERRUPTION_WORDS=3
AGENT_FALSE_INTERRUPTION_TIMEOUT=2.0
AGENT_RESUME_FALSE_INTERRUPTION=true

# Silence: after the first number of seconds she asks if they are there;
# after the second number more, she says goodbye and ends the call.
AGENT_IDLE_PROMPT_SECONDS=12
AGENT_IDLE_HANGUP_SECONDS=15

# Noise: turns in a row she could not use (background talk, garbled audio)
# before she says a counsellor will call at a better time and hangs up.
AGENT_UNCLEAR_TURNS_BEFORE_CLOSE=4

# Phone calls only: how long Maya waits for the lead to pick up before the
# call is recorded as no-answer. Keep it above the carrier's 40s ring limit.
AGENT_ANSWER_TIMEOUT_SECONDS=45

# Token budget for the brain. Each reply sends the instructions, the tools
# and only the last this many transcript lines (a lead line or a Maya line
# each count as one). The full transcript is still stored. 12 is six
# exchanges. Lower it if Groq's free tier still returns 429s; 0 sends all.
AGENT_HISTORY_ITEMS=12

# When the brain returns 429 (rate limited): how many retries and the wait
# between them, in seconds. Groq's free tier asks for about six seconds,
# so five tries three seconds apart get through instead of losing the turn.
AGENT_LLM_MAX_RETRIES=5
AGENT_LLM_RETRY_INTERVAL=3.0


# ---------------------------------------------------------------------------
# Booking a counsellor slot
#
# Maya turns "tomorrow at six" into an exact time using this timezone, and
# tells leads when counsellors are available in these words.
# ---------------------------------------------------------------------------

BOOKING_TIMEZONE=Asia/Kolkata
COUNSELLOR_HOURS=Monday to Saturday, ten in the morning to seven in the evening

# The same hours as numbers on the 24 hour clock. The code that turns the
# lead's words into a time uses these to read "six" as 6 pm, not 6 am.
# Keep them in step with the sentence above.
COUNSELLOR_WORK_START=10
COUNSELLOR_WORK_END=19


# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# What she calls herself, and who she says she is calling for.
AGENT_NAME=Maya
AGENT_COMPANY=Lemniscate Growth

# Which conversation she runs.
#   short   greet, language, ask for a day and time, book, goodbye. Nothing
#           else. Use this while testing the booking, Zoom and WhatsApp
#           chain: fewest turns, fewest tokens.
#   full    the six stage counselling script: confirm identity, ask what
#           they want to know, offer the session, exact slot with read
#           back, book, close.
AGENT_FLOW=short

# Seconds between transcript saves while the call is live. Lower means less
# lost if the worker crashes, at the cost of more writes.
AGENT_FLUSH_INTERVAL_SECONDS=5

# Write a four-line CRM summary when the call ends. Set to false if the
# summary step errors; the transcript is stored either way.
AGENT_GENERATE_SUMMARY=true

# Rooms the agent will act on. Must match the backend's room naming.
AGENT_ROOM_PREFIX=call-
