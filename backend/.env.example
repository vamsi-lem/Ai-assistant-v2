# ---------------------------------------------------------------------------
# AI Voice Platform v2 - backend environment
#
# Copy this file to `.env` in the same folder and fill it in.
# NEVER commit `.env`. The .gitignore already excludes it.
# ---------------------------------------------------------------------------

APP_ENV=development
PORT=8000

# Comma separated. Add your Vercel URL here when you deploy, or the browser
# will fail with a CORS error that looks like the backend being down.
CORS_ORIGINS=http://localhost:5173


# ---------------------------------------------------------------------------
# Supabase
#
# supabase.com -> your project -> Settings -> API
#
# SUPABASE_SECRET_KEY is the SECRET (service role) key, not the anon key. It
# bypasses row level security, which is the whole point: the tables deny the
# anon key everything, so only this server can read or write lead data.
#
# This value must never appear in the frontend, in a VITE_ variable, or in git.
# ---------------------------------------------------------------------------

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------------------------
# LiveKit
#
# cloud.livekit.io -> Settings -> Keys. Needed on both transports: browser
# needs a join token, phone needs the room to exist before the carrier dials
# into it.
# ---------------------------------------------------------------------------

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ---------------------------------------------------------------------------
# Agent authentication
#
# Shared secret the agent presents on the X-Agent-Key header to read lead
# context and write transcripts. Must match AGENT_API_KEY in agent/.env
# exactly.
#
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------

AGENT_API_KEY=


# ---------------------------------------------------------------------------
# How the lead's audio reaches the agent
#
#   browser  The lead joins the LiveKit room from their browser over WebRTC.
#            No carrier, no phone number, no per-minute cost. Works today.
#            Use this for all development.
#
#   phone    LiveKit dials their mobile through Plivo and the answered call
#            lands in the room. Needs the Plivo number and one LiveKit
#            outbound SIP trunk. See docs/PHONE.md.
# ---------------------------------------------------------------------------

CALL_TRANSPORT=browser


# ---------------------------------------------------------------------------
# Telephony
#
# With TELEPHONY_ENABLED=false, a phone-transport request saves the lead and
# returns a clear "not configured" reason. It does not pretend to have dialled.
# ---------------------------------------------------------------------------

TELEPHONY_ENABLED=false
TELEPHONY_PROVIDER=plivo

# console.plivo.com -> Account -> Keys & Credentials. Only used to verify
# Plivo webhooks; dialling itself goes through the LiveKit trunk below.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# The Indian number you rent from Plivo, in E.164, e.g. +918012345678. This
# is the caller ID the lead sees. Its series decides what Maya may say on
# it: a 140 number is promotional only; anything else is service calls only.
PLIVO_FROM_NUMBER=

# The LiveKit OUTBOUND trunk that points at your Plivo SIP trunk. Created
# once, in the LiveKit dashboard or CLI, with the Plivo termination domain
# and the credential you made in Plivo (docs/PHONE.md, step 2). Starts ST_.
LIVEKIT_SIP_TRUNK_ID=

# Only for the inbound direction (a lead calling Maya). Leave blank.
LIVEKIT_SIP_URI=

# Public URL of THIS backend. Not needed for calls; LiveKit reports status
# directly. Set it only if you enable Plivo webhooks. No trailing slash.
PUBLIC_BASE_URL=


# ---------------------------------------------------------------------------
# Bookings: counsellor slot, meeting link, WhatsApp confirmation
#
# When Maya books a slot on a call, the backend saves it, creates a meeting
# link and sends it to the lead on WhatsApp. Each provider is optional: with
# "none" the booking is still saved and shown on the counsellor dashboard,
# marked with what was not sent. Setup steps: docs/BOOKINGS.md
# ---------------------------------------------------------------------------

BOOKING_TIMEZONE=Asia/Kolkata
BOOKING_DURATION_MINUTES=30
# Appears in the WhatsApp message: "Team <COMPANY_NAME>"
COMPANY_NAME=Lemniscate Growth

# Meeting links: zoom | google | none.
# This is the DEFAULT platform, used when the lead has no preference. Fill
# in the credentials of BOTH platforms below and Maya asks the lead on the
# call "Google Meet or Zoom?"; a lead who names one gets that one, a lead
# who says anything is fine gets the default. With only one platform's
# credentials filled in, she does not ask.
MEETING_PROVIDER=google

# Zoom: marketplace.zoom.us -> Develop -> Build App -> Server-to-Server OAuth.
# Add scope meeting:write:admin, activate the app, copy the three values.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Whose Zoom account hosts the meetings. "me" is the account owner.
ZOOM_HOST_USER=me

# Google Meet: an OAuth client and a one-time refresh token for the
# counsellor's Google account. Five minute walkthrough in docs/BOOKINGS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# WhatsApp: meta | none
WHATSAPP_PROVIDER=none
# developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# The approved template (docs/BOOKINGS.md has the body to submit). For the
# very first test use hello_world, which Meta pre-approves for every account.
WHATSAPP_TEMPLATE_NAME=booking_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en

# Counsellor dashboard (frontend /#/counsellor) asks for this once.
# Generate like AGENT_API_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_KEY=


# ---------------------------------------------------------------------------
# Compliance
#
# DND_CHECK_ENABLED wires in the do-not-call check before dialling. The check
# itself is not implemented yet and currently returns False for every number,
# which the startup log warns about. Implement it before calling anyone outside
# a test list.
#
# CONSENT_WINDOW_DAYS is how long explicit consent stays valid for a service
# call. Seven days is the figure in India's commercial calling rules. Do not
# lengthen it without advice.
# ---------------------------------------------------------------------------

DND_CHECK_ENABLED=true
CONSENT_WINDOW_DAYS=7


# ---------------------------------------------------------------------------
# Brakes on the public form
#
# Every accepted submission places a paid call, and the form is open to the
# internet once deployed. These two limits stop a script from burning the
# carrier balance without getting in the way of a real lead.
#
# LEAD_MAX_PER_IP_PER_HOUR    submissions accepted from one client address in
#                             a rolling hour. Over the limit gets a 429. 0 = off.
# LEAD_PHONE_COOLDOWN_MINUTES minimum gap between two calls to the same
#                             number. The lead is still saved, the call is
#                             skipped and the response says why. 0 = off.
# ---------------------------------------------------------------------------

LEAD_MAX_PER_IP_PER_HOUR=5
LEAD_PHONE_COOLDOWN_MINUTES=60
