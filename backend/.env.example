# ---------------------------------------------------------------------------
# AI Voice Platform v2 - backend environment
#
# Copy this file to `.env` in the same folder and fill it in.
# NEVER commit `.env`. The .gitignore already excludes it.
# ---------------------------------------------------------------------------

APP_ENV=development
PORT=8000

# Comma separated. Add your Vercel URL here when you deploy, or the browser
# will fail with a CORS error that looks like the backend being down.
CORS_ORIGINS=http://localhost:5173


# ---------------------------------------------------------------------------
# Supabase
#
# supabase.com -> your project -> Settings -> API
#
# SUPABASE_SECRET_KEY is the SECRET (service role) key, not the anon key. It
# bypasses row level security, which is the whole point: the tables deny the
# anon key everything, so only this server can read or write lead data.
#
# This value must never appear in the frontend, in a VITE_ variable, or in git.
# ---------------------------------------------------------------------------

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------------------------
# LiveKit
#
# cloud.livekit.io -> Settings -> Keys. Needed on both transports: browser
# needs a join token, phone needs the room to exist before the carrier dials
# into it.
# ---------------------------------------------------------------------------

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ---------------------------------------------------------------------------
# Agent authentication
#
# Shared secret the agent presents on the X-Agent-Key header to read lead
# context and write transcripts. Must match AGENT_API_KEY in agent/.env
# exactly.
#
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------

AGENT_API_KEY=


# ---------------------------------------------------------------------------
# How the lead's audio reaches the agent
#
#   browser  The lead joins the LiveKit room from their browser over WebRTC.
#            No carrier, no phone number, no per-minute cost. Works today.
#            Use this for all development.
#
#   phone    The carrier dials their mobile and bridges the answered call into
#            the room. Needs a carrier account, an Indian number, and LiveKit
#            India region pinning.
# ---------------------------------------------------------------------------

CALL_TRANSPORT=browser


# ---------------------------------------------------------------------------
# Telephony - leave all of this blank until your carrier account is ready
#
# With TELEPHONY_ENABLED=false, a phone-transport request saves the lead and
# returns a clear "not configured" reason. It does not pretend to have dialled.
# ---------------------------------------------------------------------------

TELEPHONY_ENABLED=false
TELEPHONY_PROVIDER=plivo

# console.plivo.com -> Account -> Keys & Credentials
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# The Indian number you rent from Plivo, in E.164. Use a landline series
# (080 Bangalore or 022 Mumbai) for service and transactional calls. Not a
# mobile number, and not 140 unless you intend promotional calls.
# Example: +918012345678
PLIVO_FROM_NUMBER=

# cloud.livekit.io -> Telephony -> SIP. Host part only, no scheme.
# Example: your-project.sip.livekit.cloud
LIVEKIT_SIP_URI=
LIVEKIT_SIP_TRUNK_ID=

# The public URL of THIS backend. The carrier fetches the answer XML from here
# and posts status callbacks back to it.
#
# Leave BLANK locally: the app then polls the carrier for status instead of
# waiting for a webhook it can never receive. Set it to your Railway domain
# once deployed, with no trailing slash.
# Example: https://ai-voice-backend-production.up.railway.app
PUBLIC_BASE_URL=


# ---------------------------------------------------------------------------
# Compliance
#
# DND_CHECK_ENABLED wires in the do-not-call check before dialling. The check
# itself is not implemented yet and currently returns False for every number,
# which the startup log warns about. Implement it before calling anyone outside
# a test list.
#
# CONSENT_WINDOW_DAYS is how long explicit consent stays valid for a service
# call. Seven days is the figure in India's commercial calling rules. Do not
# lengthen it without advice.
# ---------------------------------------------------------------------------

DND_CHECK_ENABLED=true
CONSENT_WINDOW_DAYS=7
