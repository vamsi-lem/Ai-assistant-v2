# ---------------------------------------------------------------------------
# AI Voice Platform v2 - frontend environment
#
# Copy this file to `.env.local` in the same folder and fill it in.
# NEVER commit `.env.local`.
#
# Every value here is shipped to the browser (the NEXT_PUBLIC_ prefix does
# that on purpose). Nothing secret belongs in this file. The backend URL is
# public by nature; the Supabase anon key is Supabase's public browser key,
# made to be shipped in a frontend. The secret key stays in backend/.env.
# ---------------------------------------------------------------------------

# Where the FastAPI backend is. Locally the backend runs on port 8000.
# On Vercel put the Render address, for example
# https://ai-assistant-v2-zd6f.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Supabase project settings, used only to sign users in and out.
# Supabase dashboard > Project Settings > API:
#   Project URL          -> NEXT_PUBLIC_SUPABASE_URL
#   anon public key      -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# All data still comes through the backend; the browser never queries tables.
NEXT_PUBLIC_SUPABASE_URL=https://fqjrfbcaodxzbubfoyvt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZxanJmYmNhb2R4emJ1YmZveXZ0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk2NjAxMDIsImV4cCI6MjEwNTIzNjEwMn0.ajgxyXFi2ndfiadbX5eCTCPx1KTY7paAHHITNliO9xc
