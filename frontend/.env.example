# ---------------------------------------------------------------------------
# Frontend environment. Copy to `.env` (or `.env.local`).
#
# ONLY VITE_* variables reach the browser, and everything in them is PUBLIC.
# Anyone can read these in devtools. Never put a Supabase secret key, a
# LiveKit API secret, a Sarvam key or a carrier token here.
#
# The LiveKit join token is minted per call by the backend and arrives in the
# form response, so the frontend needs no LiveKit credentials of its own.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8000/api
